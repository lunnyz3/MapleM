PORT=3000
NEXON_OPEN_API_KEY=your_nexon_open_api_key
NEXON_API_BASE_URL=https://open.api.nexon.com
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@maplem.gmvdmys.mongodb.net/maplem?retryWrites=true&w=majority&appName=mapleM
MONGODB_LOG_THROTTLE_MS=120000

# Node chat proxy
CHATBOT_ENABLED=false
PYTHON_CHAT_BASE_URL=http://localhost:8001
CHAT_PROXY_TIMEOUT_MS=20000
CHAT_COOKIE_NAME=chat_sid
CHAT_COOKIE_MAX_AGE_SEC=15552000
CHAT_COOKIE_SECURE=false

# Item share
KAKAO_JS_KEY=
SHARE_ITEM_IMAGE_PUBLIC_DIR=uploads/item-share
SHARE_ITEM_IMAGE_MAX_BYTES=2097152
SHARE_ITEM_IMAGE_TTL_SEC=86400
SHARE_ITEM_IMAGE_CLEANUP_INTERVAL_MS=600000

# Python chatbot service
CHATBOT_REQUIRE_ES_GATE=true
CHATBOT_ES_GATE_READY=false
CHATBOT_SESSION_TTL_SECONDS=600
CHATBOT_SESSION_HISTORY_LIMIT=40
REDIS_URL=redis://localhost:6379/0
MONGO_DB_NAME=maplem
MONGO_LOG_COLLECTION=requestlogs

# Elasticsearch (Elastic Cloud)
ELASTICSEARCH_URL=https://<cluster-id>.<region>.aws.cloud.es.io:443
ELASTICSEARCH_API_KEY=<api_key>
ELASTICSEARCH_INDEX_ALIAS=maplem-rag
ELASTICSEARCH_TEXT_FIELD=content
ELASTICSEARCH_SPARSE_FIELD=content_embedding
ELASTICSEARCH_ELSER_MODEL_ID=.elser_model_2
ELASTICSEARCH_BM25_SIZE=10
ELASTICSEARCH_ELSER_SIZE=10
ELASTICSEARCH_RRF_K=60

# Vertex AI Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<project-id>
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-2.5-flash
